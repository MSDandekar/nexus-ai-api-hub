# Project metadata
PROJECT_NAME="AI Nexus — Intelligent Multi-Model API Hub"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration (SQLite default, or postgresql+asyncpg://user:pass@host/db)
DATABASE_URL="sqlite+aiosqlite:///./ai_nexus.db"

# AI Provider Credentials (Keys remain strictly on the backend)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""

# Gateway Master Admin Key (Used for testing and administrator access)
DEFAULT_ADMIN_API_KEY="nexus-dev-master-key-2026"

# Payload limits
MAX_FILE_SIZE_BYTES=10485760
